# openIMIS Demo Frontend (React + Material UI)
OPENIMIS_BASE_URL=https://demo.openimis.org

# openIMIS Demo Backend (Django REST + GraphQL)
OPENIMIS_API_BASE_URL=https://demo.openimis.org/api
OPENIMIS_GRAPHQL_URL=https://demo.openimis.org/api/graphql

# Public test credentials
OPENIMIS_USERNAME=Admin
OPENIMIS_PASSWORD=admin123

# PostgreSQL connection (used for direct database assertions)
# Defaults mirror the openIMIS Docker image (ghcr.io/openimis/openimis-pgsql:develop)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=test_imis
PG_USER=IMISuser
PG_PASSWORD=IMISuser@1234
PG_SSL=false